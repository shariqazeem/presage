# Called configuration. Copy to .env.local and fill in. Never commit real values.

# --- Network -------------------------------------------------------------
# metis (Andromeda, chain 1088) or metis-sepolia (59902)
NEXT_PUBLIC_CALLED_NETWORK=metis
# Optional: an RPC to try first. NEXT_PUBLIC_CALLED_RPC_ONLY=1 uses only it (rehearsals).
NEXT_PUBLIC_CALLED_RPC_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Keys ----------------------------------------------------------------
# The engine's hot key: seals, reveals, delivers paid calls, settles. Needs METIS for gas.
CALLED_RUNNER_ADDRESS=
CALLED_RUNNER_KEY=
# Contract owner and owner of the house agents' identities. Keep it off the server.
CALLED_DEPLOYER_ADDRESS=
CALLED_DEPLOYER_KEY=
# Signs the wallet sign-in cookie (32+ random characters).
CALLED_SESSION_SECRET=

# --- Models (any OpenAI-compatible gateway) -------------------------------
LLM_BASE_URL=
LLM_API_KEY=
# Oracle voters, comma separated; called-quant-v1 always votes as well.
ORACLE_MODELS=
# ST Quant's chart read (needs image input), the readers tried when it returns nothing, and the strategy compiler.
VISION_MODEL=
VISION_FALLBACK_MODELS=
COMPILER_MODEL=
STQUANT_MAX_AI_READS_PER_DAY=60

# --- Market data ---------------------------------------------------------
# Optional free CoinGecko demo key: about six times more DEX requests than GeckoTerminal's public API.
COINGECKO_API_KEY=
STQUANT_NETWORKS=bsc,x-layer

# --- Telegram ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT=
# Optional public channel for "call sealed" posts (contents stay private until revealed).
TELEGRAM_CHANNEL_ID=
# Your own chat id: the engine warns you there when the runner runs low on gas.
FOUNDER_TELEGRAM_CHAT_ID=

# --- Wallets -------------------------------------------------------------
# Reown (WalletConnect) project id, for mobile wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Storage -------------------------------------------------------------
CALLED_DB_PATH=var/called.db
CALLED_CHART_DIR=var/charts

# --- Pings (Web Push) -----------------------------------------------------
# Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_WEB_PUSH_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=https://called.xyz
