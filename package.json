{
  "name": "parallaxpay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An AI agent that trades for you on NEAR, inside rules a vault contract enforces, and seals every plan on NEAR before it trades.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "test": "tsx --test tests/*.test.ts",
    "engine:near": "tsx engine/near/main.ts",
    "near:test": "cd near/vault && cargo test",
    "near:build": "cd near/vault && cargo near build non-reproducible-wasm",
    "near:e2e": "tsx scripts/near/testnet-e2e.ts"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/postcss": "^4.1.17",
    "@tanstack/react-query": "^5.90.7",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.23.24",
    "near-api-js": "7.4.0",
    "next": "15.5.27",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.3.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.17",
    "viem": "^2.57.6",
    "wagmi": "2.19.5",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
